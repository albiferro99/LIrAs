double Fp;\
double lambda, mi;\
const double passout_th = 1.0;\
const double iteration_time = 3.0;\
const double YOUNG_SICK[2] = \{0.001865, 0.005117\};\
const double YOUNG_SICK_SIGMA[2] = \{0.000719, 0.000001\};\
\
// Errors Model\
int obey, disobey;\
double freeWillTh;\
double fw;\
int TE;\
double lambda_crit;\
double hs, crit, non_crit;\
int FS =100;\
\
void updateHealthDangerProb() \{\
    crit = hs + hs * humanFatigue[id-1];\
    non_crit = FS - crit;\
\}\
\
// Fatigue Sharing Parameters\
bool ONCE_FTG = true;\
bool ONCE_POS = true;\
\
meta int v;\
\
void updateF(double coeff, bool walking) \{\
    // if two human instances are the same person,\
    // residual conditions must be retrieved\
\
    if(walking) humanFatigue[id-1] = 1-(1-humanFatigue[id-1])*exp(coeff*Tpoll);\
    else humanFatigue[id-1] = humanFatigue[id-1]*exp(coeff*Tpoll);\
\
    humanFatigue[id-1] = fmax(0, humanFatigue[id-1]);\
\}\
\
\
\
bool is_crit = false;\
bool ignore_crit = false;\
int collisions = 0;\
\
int e_obey=100, e_disobey=0;\
int e_FW_th = 101;\
int e_delta_x100 = 9999;\
int e_lambda_inv = 9999;\
int e_crit = 0;\
\
\
void initHuman() \{\
\
    t = 0;\
    tUpd = 0;\
    F = 0;\
    Fp = 0;\
\
    humanPositionX[id - 1] = h_startX[id-1];\
    humanPositionY[id - 1] = h_startY[id-1];\
\
    humanPositionX[id-1] = humanPositionX[id-1];\
    humanPositionY[id-1] = humanPositionY[id-1];\
    \
    lambda = random_normal(YOUNG_SICK[0], YOUNG_SICK_SIGMA[0]);\
    mi = random_normal(YOUNG_SICK[1], YOUNG_SICK_SIGMA[1]);\
\
    obey = e_obey;\
    disobey = e_disobey;\
    freeWillTh = e_FW_th;\
    lambda_crit = 1/e_lambda_inv;\
    hs = e_crit;\
    crit = 1.0;\
    non_crit = 999.0;\
\}\
    
