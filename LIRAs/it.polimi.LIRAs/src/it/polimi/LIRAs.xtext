// Test commit
grammar it.polimi.LIRAs with org.eclipse.xtext.common.Terminals

generate lIRAs "http://www.polimi.it/LIRAs"

// Others modified files:
// LIRAsValidator.Java - in the folder /it.polimi.LIRAs/src/it.polimi.validation
// LIRAsGenerator.xtend - in the folder /it.polimi.LIRAs/src/it.polimi.generator

// Model rule represents the root of the model
Model:
	NL*
    pattern=Pattern
    sequence+=Sequence*
    conclusion=Conclusion?
;

// Definition of the pattern name and the parameters to be pass (and use in the specification)
Pattern:
    name=ID NL+
	(('agents:'  NL+
	('humans:' (human+=Human (',' human+=Human)*)? NL+)?
	('robots:' (robot+=Robot (',' robot+=Robot)*)? NL+)? )
    | 'locations:' (location+=Location (',' location+=Location)*)? NL+
    | 'resources:' (resources+=Resource (',' resources+=Resource)*)? NL+)*
;

// Sequence rule defines the structure of a sequence
Sequence:
	agent=Agent ('default' action=Action)? ':' NL+ 
	(subSequence+=SubSequence)*
;

// SubSequence rule defines the structure of a subsequence within a sequence
SubSequence:
    i=INT ('-' j=INT)? ':' ( ( ( loop+=Loop) | ((actionC+=ActionC) ) )? NL )+
;

Conclusion:
	'success:' condition+=Condition NL*
	'failure:' condition+=Condition NL*
;

Loop:
	('skip' ('all')? 'if' condition=Condition) | ('restart' ('all')?  'if' condition=Condition)
;

ConditionalStatement:
	{ConditionalStatement} cs1 = 'until' condition+=Condition
	| cs2 = 'if' condition+=Condition 'else' action=Action
	| cs3 = 'if' condition+=Condition 'else' action=Action 'until' condition+=Condition
	| cs4 = 'wait' n=INT
;

// Action rule defines the various actions that can be performed
Action:
	({Action} actionType = 'stop' 
    | actionType = 'moveTo' target=Target 
    | ((actionType = 'fetch'| actionType = 'pick' | actionType = 'deliver' | actionType = 'leave') & resource=Resource) 
    | actionType = 'follow' agent=Agent ('(' target=Target ')')?
    | actionType = 'receiveFrom' agent=Agent) 
;

ActionC:
	(actionType = 'stop' 
    | actionType = 'moveTo' target=Target 
    | ((actionType = 'fetch'| actionType = 'pick' | actionType = 'deposit' | actionType = 'deliver' | actionType = 'leave') & resource=Resource) 
    | actionType = 'follow' agent=Agent ('(' target=Target ')')?
    | actionType = 'receiveFrom' agent=Agent) (conditionalStatement+=ConditionalStatement)?
;

Condition:
	( atomicPredicate+=AtomicPredicate)
	( (op += '&&' | op += '||') ( atomicPredicate+=AtomicPredicate) )*
;

AtomicPredicate:
	{AtomicPredicate} (negated?='!')?
	(ap = 'tired' 
	| ap = 'time' '(' n=INT ')' 
	| ap = 'position' '(' agent=Agent',' location=Location')'
	| ap = 'possess' '(' agent=Agent',' resource=Resource')'
	| ap = 'busy' '(' agent=Agent')'
	| ap = 'still' '(' agent=Agent')'
	| relation=Relation
	)
;
	
Relation:
    ('dist' '(' agent+=Agent ',' agent+=Agent ')' ('>' | '<' | '>=' | '<=' | '==' | '!=') th=INT)
    | 'soc' '(' agent+=Agent ')' ('>' | '<' | '>=' | '<=' | '==' | '!=') th=INT
;

// Target rule specifies the target of an action, it can be an agent, a location or a resources
Target: 
	name=ID
;

// Agent rule defines the properties of an agent
Agent:
	name=ID
;

Human:
	name=ID
;

Robot:
	name=ID
;

// Location rule defines the coordinates of a location
Location:
	name=ID
;

// Resource rule defines the properties of a resource
Resource:
	name=ID
;

// NL terminal rule specifies newline characters
terminal NL:
	(' '* '\r'? '\n' '\t'*)+
;



