Prova

agents:
	humans: Human, Human2
	robots: Robot, Robot2
locations: room1, room2
resources: item

Human:
	1: moveTo room1 if !position(Human, room1) else stop
	5: moveTo room2 if !position(Human, room1) else stop
	
	
Robot:
	2-4: follow Human (room2) if position(Human, room2) else stop
	moveTo room1 if position(Human, room1) else stop
	5:moveTo room1 if position(Human, room1) else stop
	moveTo room1
	moveTo room1 if position(Human, room1) else stop

Robot2:
	1: stop
	
	