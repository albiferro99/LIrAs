RobotFollower

agents: 
	humans: Doctor, Human
	robots: Robot
	
locations: Room1, Room2

resources: item1, item2

Doctor default stop:
	1: stop
	skip all if tired
	restart if still(Robot)
	stop until dist(Doctor, Robot)==0
2: moveTo Robot
3: 
4: fetch item1
5-6:
stop
stop
moveTo Room1 until tired && !tired
moveTo Robot if position(Robot, Room1) || tired else stop
deliver item1 if possess(Human, item1) else stop until busy(Doctor)
leave item2 wait 300
follow Doctor (Room2)
follow Robot
receiveFrom Doctor
deliver item2
stop
8:

Human:
1-6: stop
moveTo Robot

Robot:
1: stop until still(Robot) && dist(Human, Robot) != 0 || soc(Robot) == 19 && !soc(Robot) >= 10


success: tired || !time(300)
failure: tired